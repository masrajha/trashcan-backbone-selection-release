{
    "schema_version": 1,
    "status": "ready_for_freeze",
    "scope": "phase3_backbone_selection",
    "model": {
        "architecture": "MaskRCNN",
        "num_object_classes": 16,
        "fpn_out_channels": 256,
        "feature_strides": [
            4,
            8,
            16,
            32
        ],
        "anchor_sizes": [
            32,
            64,
            128,
            256,
            512
        ],
        "aspect_ratios": [
            0.5,
            1.0,
            2.0
        ],
        "box_roi_output_size": 7,
        "box_roi_sampling_ratio": 2,
        "mask_roi_output_size": 14,
        "mask_roi_sampling_ratio": 2,
        "pretraining_scope": "backbone_only",
        "detector_pretrained": false,
        "rpn_fg_iou_thresh": 0.7,
        "rpn_bg_iou_thresh": 0.3,
        "rpn_nms_thresh": 0.7,
        "rpn_batch_size_per_image": 256,
        "rpn_positive_fraction": 0.5,
        "rpn_pre_nms_top_n_train": 2000,
        "rpn_pre_nms_top_n_test": 1000,
        "rpn_post_nms_top_n_train": 2000,
        "rpn_post_nms_top_n_test": 1000,
        "box_score_thresh": 0.05,
        "box_nms_thresh": 0.5,
        "box_detections_per_img": 100,
        "box_fg_iou_thresh": 0.5,
        "box_bg_iou_thresh": 0.5,
        "box_batch_size_per_image": 512,
        "box_positive_fraction": 0.25
    },
    "training": {
        "input_height": 320,
        "input_width": 576,
        "min_size": 320,
        "max_size": 576,
        "batch_size": 2,
        "gradient_accumulation_steps": 2,
        "optimizer": "SGD",
        "learning_rate": 0.001,
        "momentum": 0.9,
        "weight_decay": 0.0005,
        "scheduler": "StepLR",
        "step_size": 10,
        "gamma": 0.1,
        "formal_epochs": 30,
        "validate_every": 3,
        "early_stopping": false,
        "precision": "amp_fp16",
        "allow_tf32": false,
        "deterministic": true,
        "num_workers": 3,
        "pin_memory": true,
        "persistent_workers": true,
        "formal_data_fraction": 1.0,
        "formal_seeds": [
            42,
            123,
            2026
        ]
    },
    "screening": {
        "smoke": {
            "data_fraction": 0.01,
            "epochs": 1,
            "seed": 42
        },
        "pilot": {
            "data_fraction": 0.1,
            "epochs": 3,
            "seed": 42
        }
    },
    "evaluation": {
        "split": "val_internal",
        "iou_type": "bbox",
        "score_threshold": 0.0,
        "primary_metric": "AP_trash_plastic",
        "best_checkpoint_rule": "maximum_AP_trash_plastic",
        "official_test_access": false
    },
    "resource_limits": {
        "device": "NVIDIA GeForce RTX 3060 Laptop GPU",
        "peak_vram_gib": 5.5,
        "oom_policy": "mark_resource_infeasible; do_not_change_batch_or_resolution_per_backbone"
    },
    "freeze": {
        "frozen_at_utc": null,
        "git_commit": null,
        "protocol_sha256": null,
        "reviewer": null
    },
    "formal_decision": {
        "selection_scope": "one_winner_per_family",
        "families": {
            "cnn": [
                "resnet50",
                "efficientnet_b0",
                "convnext_tiny"
            ],
            "transformer": [
                "swin_t",
                "pvtv2_b1"
            ]
        },
        "reserve_candidates": [
            "swin_v2_t"
        ],
        "primary_metric": "AP_trash_plastic",
        "aggregation": {
            "unit": "independent_training_seed",
            "paired_by_seed": true,
            "formal_seed_count": 3,
            "statistics": [
                "per_seed",
                "mean",
                "sample_standard_deviation",
                "minimum",
                "maximum",
                "paired_seed_wins"
            ],
            "inferential_claims_permitted": false
        },
        "ap_equivalence_tolerance": 0.01,
        "critical_false_negative": {
            "category": "trash_plastic",
            "category_id": 14,
            "score_threshold": 0.05,
            "iou_threshold": 0.5,
            "area_scope": [
                "medium",
                "large"
            ],
            "metric": "critical_false_negative_rate",
            "area_definition": "COCO_area_ranges_at_evaluation_scale"
        },
        "pareto": {
            "separate_by_family": true,
            "maximize": [
                "mean_AP_trash_plastic"
            ],
            "minimize": [
                "peak_reserved_vram_mb",
                "median_end_to_end_latency_ms"
            ]
        },
        "tie_break_order": [
            "mean_AP_trash_plastic",
            "lower_AP_sample_standard_deviation",
            "lower_critical_false_negative_rate",
            "higher_AP75_trash_plastic",
            "lower_peak_reserved_vram_mb",
            "lower_median_end_to_end_latency_ms",
            "lower_parameter_count",
            "simpler_implementation"
        ],
        "composite_score_allowed": false,
        "pilot_accuracy_ranking_allowed": false,
        "reserve_activation_rule": "Swin-V2-T may replace a Transformer candidate only after a predefined implementation or reproducibility failure, before formal result comparison, with reason and reviewer recorded.",
        "eligible_set": "pareto_frontier_per_family"
    },
    "benchmark_protocol": {
        "version": 1,
        "device": "NVIDIA GeForce RTX 3060 Laptop GPU",
        "power_condition": "AC_connected_high_performance",
        "input_height": 320,
        "input_width": 576,
        "precision": "amp_fp16",
        "allow_tf32": false,
        "inference": {
            "scenario": "single_stream_batch_1",
            "split": "val_internal",
            "sample_scope": "one_complete_split_pass_per_repetition",
            "batch_size": 1,
            "warmup_iterations": 50,
            "repetitions": 3,
            "model_order": "counterbalanced",
            "cuda_synchronize": true,
            "latency_scopes": [
                "model_only_cuda_event",
                "end_to_end_wall_clock_without_file_io"
            ],
            "statistics": [
                "mean",
                "median",
                "sample_standard_deviation",
                "p90",
                "p95",
                "p99",
                "throughput_fps"
            ],
            "ap_score_threshold": 0.0,
            "operational_score_threshold": 0.05,
            "max_detections_per_image": 100,
            "quality_gate_required": true,
            "sample_order": "fixed_manifest_order",
            "file_io_in_timed_region": false,
            "model_only_clock": "torch_cuda_event",
            "end_to_end_clock": "time_perf_counter"
        },
        "training": {
            "batch_size": 2,
            "gradient_accumulation_steps": 2,
            "measure_epoch_duration": true,
            "measure_total_duration": true,
            "measure_peak_allocated_vram": true,
            "measure_peak_reserved_vram": true
        },
        "environmental_controls": {
            "close_nonessential_gpu_processes": true,
            "record_temperature_and_power": true,
            "record_start_and_end_timestamps_utc": true,
            "same_software_environment": true
        },
        "required_metadata": [
            "run_id",
            "backbone",
            "checkpoint_sha256",
            "manifest_sha256",
            "protocol_sha256",
            "source_git_commit",
            "git_worktree_clean",
            "python_version",
            "pytorch_version",
            "torchvision_version",
            "cuda_runtime_version",
            "cudnn_version",
            "gpu_name",
            "gpu_driver_version",
            "power_condition",
            "input_shape",
            "precision",
            "batch_size",
            "warmup_iterations",
            "measured_image_count",
            "repetition",
            "model_order",
            "started_at_utc",
            "finished_at_utc"
        ]
    },
    "run_validity": {
        "required": [
            "registered_backbone_and_pretrained_weights",
            "registered_formal_seed",
            "complete_epoch_budget",
            "finite_loss_and_metrics",
            "required_artifacts_present",
            "matching_manifest_and_protocol_hashes",
            "clean_source_commit",
            "official_test_untouched"
        ],
        "failure_categories": [
            "infrastructure_failure",
            "implementation_failure",
            "resource_infeasible",
            "numerical_failure",
            "protocol_violation"
        ],
        "rerun_policy": "Only infrastructure failures may be rerun unchanged. Other failures remain recorded and require a protocol amendment before any changed rerun.",
        "exclude_failed_runs_from_mean": true,
        "report_all_failures": true,
        "require_clean_git_worktree": true
    }
}
